    {
        "id": "178198080673feb0",
        "type": "function",
        "z": "fa381470a27ccb1f",
        "name": "Converter para número",
        "func": "// Converte texto vindo do MQTT em número\nmsg.payload = parseFloat(msg.payload);\nif (isNaN(msg.payload)) {\n    node.warn(\"Valor inválido recebido: \" + msg.payload);\n    return null;\n}\nreturn msg;",
