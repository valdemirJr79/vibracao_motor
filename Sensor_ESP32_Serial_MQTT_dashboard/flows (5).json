    {
        "id": "87b099e60a3680c5",
        "type": "function",
        "z": "fa381470a27ccb1f",
        "name": "Verificar Limite e Gerar Alerta",
        "func": "const limite = 0.04;\nlet alerta = {};\nif (msg.payload < limite) {\n    alerta.text = `⚠️ ALARME: Distância baixa (${msg.payload.toFixed(3)} m)`;\n    alerta.color = \"red\";\n} else {\n    alerta.text = `✅ Distância segura (${msg.payload.toFixed(3)} m)`;\n    alerta.color = \"green\";\n}\nlet msg_text = { payload: alerta.text, color: alerta.color };\nlet msg_popup = null;\nif (msg.payload < limite) {\n    msg_popup = { payload: alerta.text, background: \"#ff0000\", position: \"top right\", timeout: 5 };\n}\nreturn [msg_text, msg_popup];",
        "outputs": 2,
        "x": 520,
        "y": 300,
        "wires": [
